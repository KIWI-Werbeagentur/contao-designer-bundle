{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_headline.html.twig" %}

{% block wrapper %}
    {% if headline.text is not empty
        or data.topline is not empty
        or data.subline is not empty
    %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block inner %}
    {% if main_class is defined and main_class is not empty %}
        {% set content_main_attributes = attrs().addClass(main_class).mergeWith(content_main_attributes|default) %}
        {% deprecated 'The "main_class" variable is deprecated, use "content_main_attributes" instead.' package='kiwi/contao-designer' version='1.1.19' %}
    {% endif %}
    <div {{ content_main_attributes|default }}>
        {# The "headline" content element does not have a wrapper element, so the
           wrapper attributes must be applied to the "_headline" component. #}
        {% with {headline: headline|default(_context)} %}
            {{ block('headline_component') }}
        {% endwith %}
    </div>
{% endblock %}
