{% for prop in props %}
{% if prop %}
@if map-get($theme-colors, '{{ prop }}') {
  $theme-colors: map-merge($theme-colors, ("{{ prop }}": {{ '$' }}{{ prop }}));
}
{% endif %}
{% endfor %}
